<style>
*,*::before,*::after{box-sizing:border-box}
img{max-width:100%}
body{margin:0}
.site{--ink:#1B2250;--bg:#FBF8F2;--pink:#F6A9C8;--rose:#EE6F8C;--mint:#93DEC6;--sky:#6CC6EE;--lilac:#CDB8F2;--butter:#FFD17E;color:var(--ink);background:var(--bg);font-family:Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.site a{color:var(--ink);text-decoration-color:var(--rose);text-underline-offset:4px;text-decoration-thickness:3px}
.site a:hover{text-decoration-color:var(--sky)}
.site a.plain{text-decoration:none}
.site a.btn:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink)}
.site .card:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--ink)}
.site .card{transition:transform .15s,box-shadow .15s}
.site.noshapes .deco{display:none}
.site .px{position:absolute;width:6px;height:6px;pointer-events:none;box-shadow:0 0 0 1px #1B2250}
.site.noshapes .px{display:none}
@keyframes hop{0%,100%{transform:translateY(0)}40%{transform:translateY(-8px)}70%{transform:translateY(1px)}}
@keyframes party{0%{filter:hue-rotate(0deg)}100%{filter:hue-rotate(360deg)}}
.site .logo .vx{transform-box:fill-box}
.site .logo:hover .vx,.site .logo:focus-visible .vx{animation:hop .6s steps(6,end) infinite}
.site .logo:hover .logo-svg,.site .logo:focus-visible .logo-svg{animation:party 1.2s steps(12,end) infinite}
@media (prefers-reduced-motion: reduce){.site .logo:hover .vx,.site .logo:hover .logo-svg{animation:none}}
.site .logo-svg{max-width:100%;height:auto}
</style>
</head>
